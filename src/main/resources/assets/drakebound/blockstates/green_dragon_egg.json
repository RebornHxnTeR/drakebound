{
  "multipart": [
    {
      "apply": {
        "model": "drakebound:block/green_dragon_egg"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "drakebound:block/egg_crack_1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "drakebound:block/egg_crack_2"
      }
    },
    {
      "when": {
        "age": "3|4"
      },
      "apply": {
        "model": "drakebound:block/egg_crack_3"
      }
    }
  ]
}